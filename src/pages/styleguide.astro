  <Section id="checks" variant="page">
    <SectionHeader eyebrow="Process" title="Checks">
      Run these before every commit. The styleguide and the guards are the contract.
    </SectionHeader>
    <CodeSample
      filename="shell"
      lang="bash"
      code={`npm run check       # token guard and copy guard\nnpm run typecheck   # astro check\nnpm run build       # static build into dist/`}
    />
  </Section>
