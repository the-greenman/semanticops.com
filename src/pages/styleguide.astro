---
import Base from "../layouts/Base.astro";
import type { Entry } from "../lib/content";
import { toBands } from "../lib/bands";
import { lookTable } from "../lib/presentation";
import AgentEdition from "../components/AgentEdition.astro";
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import CodeSample from "../components/CodeSample.astro";
import ConceptCard from "../components/ConceptCard.astro";
import ConceptEntry from "../components/ConceptEntry.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Legend from "../components/Legend.astro";
import OnThisPage from "../components/OnThisPage.astro";
import PageLinks from "../components/PageLinks.astro";
import Lede from "../components/Lede.astro";
import Quote from "../components/Quote.astro";
import Pronunciation from "../components/Pronunciation.astro";
import Prose from "../components/Prose.astro";
import PrincipleItem from "../components/PrincipleItem.astro";
import ProjectCard from "../components/ProjectCard.astro";
import RecordCard from "../components/RecordCard.astro";
import RelationList from "../components/RelationList.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SemanticOpsMark from "../components/SemanticOpsMark.astro";
import SrsMark from "../components/SrsMark.astro";
import Tag from "../components/Tag.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Wordmark from "../components/Wordmark.astro";
import PageBands from "../components/page/PageBands.astro";
import BrokenRing from "../components/diagram/BrokenRing.astro";
import Canvas from "../components/diagram/Canvas.astro";
import CapabilityStack from "../components/diagram/CapabilityStack.astro";
import Cluster from "../components/diagram/Cluster.astro";
import Disc from "../components/diagram/Disc.astro";
import Figure from "../components/diagram/Figure.astro";
import Glyph from "../components/diagram/Glyph.astro";
import Halves from "../components/diagram/Halves.astro";
import HeroCluster from "../components/diagram/HeroCluster.astro";
import Knockout from "../components/diagram/Knockout.astro";
import Link from "../components/diagram/Link.astro";
import MaturityLadder from "../components/diagram/MaturityLadder.astro";
import ProjectionFan from "../components/diagram/ProjectionFan.astro";
import RelationSentence from "../components/diagram/RelationSentence.astro";
import RingNode from "../components/diagram/RingNode.astro";
import Target from "../components/diagram/Target.astro";
import TwoSurfaces from "../components/diagram/TwoSurfaces.astro";
import ColourTable from "../components/styleguide/ColourTable.astro";
import MarkRow from "../components/styleguide/MarkRow.astro";
import Specimen from "../components/styleguide/Specimen.astro";
import Swatch from "../components/styleguide/Swatch.astro";
import TokenRow from "../components/styleguide/TokenRow.astro";
import { colourReport, loadTokens } from "../../scripts/lib/tokens.mjs";

// The token tables are the token files, parsed at build time: they cannot drift.
const t = loadTokens(process.cwd());
const colourPrimitives = [...t.primitives].filter(([, v]) => /^#/.test(v));
const meanings: Record<string, string> = {
  "--color-structure": "Boundaries: containers and repositories",
  "--color-record": "Records: the substance",
  "--color-field": "Fields and atomic values",
  "--color-relation": "Relations and connectors",
  "--color-note": "Notes: free text, a fill with a relation edge",
};
const semantic = colourReport(t).map((r: any) => ({ ...r, meaning: meanings[r.name] }));
const light = [...t.light];
const pick = (re: RegExp) => light.filter(([n]) => re.test(n));
const sizes = pick(/^--size-(xs|sm|base|md|lg|xl|2xl|display|h1|h2|h3|standfirst|code|diagram|diagram-lg)$/);
const weights = pick(/^--weight-/);
const tracking = pick(/^--tracking-/);
const leading = pick(/^--leading-/);
const spaces = pick(/^--space-/);
const radii = pick(/^--radius-/);
const rules = pick(/^--rule/);
const widths = pick(/^--width-/);
const z = pick(/^--z-/);
const fonts = pick(/^--font-/);
const shadows = pick(/^--shadow-/);
const componentTokens = [...t.components].filter(([n]) => !n.startsWith("--dg-"));
const toc = [
  ["tokens", "Tokens"],
  ["meaning", "Colour meaning"],
  ["layout", "Layout"],
  ["content", "Content"],
  ["cards", "Cards"],
  ["assembly", "Page assembly"],
  ["marks", "Marks"],
  ["primitives", "Diagram primitives"],
  ["diagrams", "Diagrams"],
  ["checks", "Checks"],
];

const proseSample = `
<h2>A relation is a claim</h2>
<p>A relation is a first-class, strictly binary, typed edge between two things. It reads <code>source [type] target</code>, and it says something about knowledge, not about who is in charge.</p>
<ul>
  <li>Store the forward form only. The reverse is read, never written.</li>
  <li>Every type is an installed definition, so a typo is a diagnostic and not a new meaning.</li>
</ul>
<blockquote>Records are the source of truth. Rendered documents are projections of those records: derived, never authoritative.</blockquote>
<table>
  <thead><tr><th>Type</th><th>Reads as</th></tr></thead>
  <tbody>
    <tr><td><code>precedes</code></td><td>comes before</td></tr>
    <tr><td><code>supersedes</code></td><td>replaces, and keeps the original</td></tr>
  </tbody>
</table>`;

// The presentation map as a table, and a tiny page of sample entries for PageBands.
const lookRows = lookTable();
const demoSection = (slug: string, title: string, eyebrow: string, lede: string, body: string): Entry => ({
  instanceId: `demo-${slug}`,
  type: "section",
  slug,
  fields: { slug, title, eyebrow, lede, body },
});
const demoEntries: Entry[] = [
  demoSection("demo-first", "A section opens a band", "Page", "Order is the data's order. Paper and page take turns from the band above.", "The entries that follow a section, up to the next one, are its items."),
  demoSection("demo-second", "The next one takes the other ground", "Paper", "Nothing here chooses a colour.", "A look in the map can ask for ink."),
  demoSection("demo-ink", "Ink only where the map asks", "Ink", "The map has an ink look for this slug, on this page only.", "The band re-resolves every colour inside it."),
];
const demoBands = toBands(demoEntries, "styleguide");

const recordJson = `{
  "instanceId": "7c2e9f41-3b8a-4d6e-a1f0-52c9e8d3b764",
  "typeId": "2a000004-0000-4000-a000-000000000004",
  "typeVersion": 1,
  "typeNamespace": "com.example.team",
  "typeName": "decision",
  "fieldValues": {
    "title": "Review the budget weekly",
    "outcome": "Agreed for one quarter, then revisit",
    "status": "ratified"
  }
}`;
const relationJson = `{
  "relationId": "3f6a1d90-84c2-4b7e-9d15-0a2e6c8f4b21",
  "relationType": "derived-from",
  "sourceInstanceId": "7c2e9f41-3b8a-4d6e-a1f0-52c9e8d3b764",
  "targetInstanceId": "b19d4e07-5a3c-4f82-8e6b-91c0d7a3f258"
}`;
---

<Base title="Styleguide" noindex>
  <Section id="top">
    <SectionHeader level="h1" eyebrow="Styleguide" title="The design system, live">
      Every token, component and diagram on the site, with its variants and a note on when to use it. Change a component and its specimen in the same change.
    </SectionHeader>
    <div class="stack">
      <nav aria-label="On this page">
        <ul class="cluster">
          {toc.map(([id, label]) => <li><Chip href={`#${id}`}>{label}</Chip></li>)}
        </ul>
      </nav>
      <div class="cluster">
        <span class="t-label">Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </Section>

  <!-- TOKENS -->
  <Section id="tokens" variant="page">
    <SectionHeader eyebrow="Foundations" title="Tokens">
      Three tiers. Primitives are raw values, read only inside tokens.css. Semantic tokens carry meaning and are what components read. Component tokens sit on :root and re-resolve inside ink bands. These tables are parsed from the token files at build time, so they cannot drift.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="bare" title="Colour primitives" note="Paper and ink from the muDemocracy system, plus a diagram palette from the the-organization.com family with lit variants for dark. Components never read these.">
        <div class="grid grid--gap-md">
          {colourPrimitives.map(([name, value]) => <Swatch name={name} value={value} />)}
        </div>
      </Specimen>
      <Specimen layout="bare" title="Semantic colour" note="What components read. Every one is redefined for dark, and the contrast column is measured against the surfaces it is read on. Graphics need 3:1, text needs 4.5:1.">
        <ColourTable rows={semantic} />
      </Specimen>
      <Specimen layout="stack" title="Typefaces" note="IBM Plex Sans for prose and headings. IBM Plex Mono, small, uppercase and letter-spaced for every label, id, eyebrow and figure number. Both are self-hosted.">
        <p>Sans: records are the source of truth.</p>
        <p class="t-mono">Mono: namespace/name@version</p>
        <div class="stack stack--xs">
          {fonts.map(([n, v]) => <TokenRow name={n} value={v} />)}
        </div>
      </Specimen>
      <Specimen layout="stack" title="Type scale" note="Fixed steps and fluid roles. Components never set a literal size: scripts/check-tokens.mjs fails the build on one.">
        <div>
          {sizes.map(([n, v]) => <TokenRow name={n} value={v} kind="size" />)}
        </div>
      </Specimen>
      <Specimen layout="stack" title="Weight, tracking and leading" note="Hierarchy comes from weight, size and the contrast between sans and mono, never from hue.">
        <div>
          {weights.map(([n, v]) => <TokenRow name={n} value={v} kind="weight" />)}
          {tracking.map(([n, v]) => <TokenRow name={n} value={v} kind="tracking" text="Record of decision" />)}
          {leading.map(([n, v]) => <TokenRow name={n} value={v} kind="leading" />)}
        </div>
      </Specimen>
      <Specimen layout="stack" title="Space and layout" note="One spacing scale and three column widths.">
        <div>
          {spaces.map(([n, v]) => <TokenRow name={n} value={v} kind="space" />)}
          {widths.map(([n, v]) => <TokenRow name={n} value={v} kind="width" />)}
        </div>
      </Specimen>
      <Specimen layout="stack" title="Shape, rules and stacking" note="Hairline rules, sharp radii (pills only for chips) and one soft shadow for floating surfaces. Stacking is a short named scale.">
        <div>
          {radii.map(([n, v]) => <TokenRow name={n} value={v} kind="radius" />)}
          {rules.map(([n, v]) => <TokenRow name={n} value={v} kind="rule" />)}
          {shadows.map(([n, v]) => <TokenRow name={n} value={v} kind="shadow" />)}
          {z.map(([n, v]) => <TokenRow name={n} value={v} />)}
        </div>
      </Specimen>
      <Specimen layout="stack" title="Component tokens" note="--block-property-state, declared on :root and on every [data-surface], each defaulting to a semantic token. A variant re-assigns the token on its own selector.">
        <div>
          {componentTokens.map(([n, v]) => <TokenRow name={n} value={v} />)}
        </div>
      </Specimen>
    </div>
  </Section>

  <!-- COLOUR MEANING -->
  <Section id="meaning">
    <SectionHeader eyebrow="Foundations" title="Colour carries one meaning each">
      Blue is structure, vermilion is records, green is fields, khaki is relations, gold is notes. Ink is the neutral: it means nothing, so it draws an adapter or a client, and a hollow ink ring is derived output. The rest of the site stays paper and ink: colour lives in diagrams, marks and focal accents, never in large fills, and code is never coloured.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="bare" title="Legend" note="The key to the diagram vocabulary, and what every diagram on this page does: each coloured shape means one idea, and anything else is neutral ink. Put it under a diagram that uses several shapes. Pass kinds to show a subset.">
        <Legend />
      </Specimen>
      <Specimen title="Tone dots" note="Eyebrow and Chip take a tone to carry the diagram colour as a small dot, so a label can say which idea it names. Use it only when the label really names that idea: the dot is the meaning, never decoration.">
        <Eyebrow tone="structure">Boundary</Eyebrow>
        <Eyebrow tone="record">Record</Eyebrow>
        <Eyebrow tone="field">Field</Eyebrow>
        <Eyebrow tone="relation">Relation</Eyebrow>
        <Eyebrow tone="note">Note</Eyebrow>
        <Chip tone="record">decision@1</Chip>
        <Chip tone="field">title</Chip>
        <Chip tone="relation">derived-from</Chip>
      </Specimen>
      <Specimen title="Knockout" note="Where shapes meet, a stroke in the ground colour cuts a clean gap. Disc, RingNode and Target do it by default (knockout prop); Knockout is the helper for any other shape.">
        <Canvas id="sg-knockout" viewBox="0 0 420 110" title="Knockout gaps" desc="Two khaki lines pass behind a record. On the left the disc has no knockout and the line touches it. On the right a ground-coloured gap separates them.">
          <Link x1={10} y1={55} x2={190} y2={55} width={3} />
          <Disc cx={100} cy={55} r={26} knockout={0} label="knockout 0" labelPosition="below" />
          <Link x1={230} y1={55} x2={410} y2={55} width={3} />
          <Disc cx={320} cy={55} r={26} knockout={6} label="knockout 6" labelPosition="below" />
        </Canvas>
      </Specimen>
    </div>
  </Section>

  <!-- LAYOUT -->
  <Section id="layout" variant="page">
    <SectionHeader eyebrow="Layout" title="Sections, header and footer">
      The page is a stack of full-bleed bands. Paper bands and ink bands alternate, and a page band sits on the white page.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="bare" title="Section: variants" note="compact tightens the padding. variant is paper (the default ground), page (white) or ink. An ink band takes the dark scheme locally, so everything inside it re-colours with no extra props, and it carries the toner texture behind its content. On the dark page a black band barely parts from night, so every band, the footer included, carries a hairline edge (--rule-band) that resolves against the page: invisible on paper, quiet on night.">
        <Section as="div" compact variant="paper"><Eyebrow>paper</Eyebrow><Lede>The default ground.</Lede></Section>
        <Section as="div" compact variant="page"><Eyebrow>page</Eyebrow><Lede>The white page, for dense reading.</Lede></Section>
        <Section as="div" compact variant="ink">
          <Eyebrow>ink</Eyebrow>
          <Lede>A dark band for a single idea.</Lede>
          <div class="cluster">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Chip tone="record">record</Chip>
            <Tag status="ratified" />
          </div>
        </Section>
      </Specimen>
      <Specimen layout="stack" title="Section: widths" note="width is narrow (reading text), default (most pages) or wide (diagrams and grids). The band is always full bleed; only the column changes.">
        <Section as="div" compact width="narrow"><Eyebrow>narrow</Eyebrow></Section>
        <Section as="div" compact width="default" variant="page"><Eyebrow>default</Eyebrow></Section>
        <Section as="div" compact width="wide"><Eyebrow>wide</Eyebrow></Section>
      </Specimen>
      <Specimen layout="stack" title="SiteHeader and SiteFooter" note="The header at the top of this page and the footer at the bottom are the live specimens. At 720px and up the header nav is inline. Below that it is a native popover opened by the Menu button: no framework, no script. The footer sits on an ink band and carries the credit, the agent edition link, the repositories and the theme control.">
        <p class="t-muted">Resize the window below 720px to see the menu.</p>
      </Specimen>
      <Specimen layout="stack" title="OnThisPage" note="An index of a long page: anchor links to its parts, in the page's order. A numbered item shows the same ordinal as the part's own heading; one without a number shows its label alone. It appears in the header of any page with four or more bands. Give a second index on one page its own title, so the two landmarks have different names." code={`<OnThisPage items={[{ href: "#field", label: "Field", number: "01" }]} />`}>
        <OnThisPage
          title="Specimen index"
          items={[
            { href: "#layout", label: "Sections, header and footer" },
            { href: "#content", label: "Eyebrow", number: "01" },
            { href: "#content", label: "Lede", number: "02" },
            { href: "#cards", label: "Cards", number: "03" },
          ]}
        />
      </Specimen>
      <Specimen title="AgentEdition" note="The quiet link from a human page to its own data: the same records as markdown and as JSON. Every page carries one, so the two-surfaces idea is something a reader can click. The hollow ring is the glyph of derived output. Each link says what it is to assistive technology, for example Markdown edition of this page, before its path." code={`<AgentEdition md="/agents/model.md" json="/agents/model.json" />`}>
        <AgentEdition md="/agents/model.md" json="/agents/model.json" />
      </Specimen>
      <Specimen layout="stack" title="PageLinks" note="Where to read next: the other pages, each a title and its summary, the whole item a link. The pages come from the data, so a page added to the repository appears here." code={`<PageLinks items={[{ href: "/model", title: "Model", summary: "..." }]} />`}>
        <PageLinks
          items={[
            { href: "#cards", title: "Cards", summary: "Containers for one idea, one record or one project." },
            { href: "#marks", title: "Marks", summary: "The SRS mark and the SemanticOps mark, at the sizes they have to work at." },
            { href: "#diagrams", title: "Diagrams", summary: "Six diagrams, each composed from the primitives." },
          ]}
        />
      </Specimen>
      <Specimen title="ThemeToggle" note="Auto follows the system. Light and dark are forced and remembered in localStorage inside try/catch. Dark is the same pair of paper and ink read the other way round, and doubles as the proof that tokens alone can reskin the site.">
        <ThemeToggle />
      </Specimen>
    </div>
  </Section>

  <!-- CONTENT -->
  <Section id="content">
    <SectionHeader eyebrow="Components" title="Content">
      The pieces text and actions are made of.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen title="Eyebrow" note="The mono label voice, above a heading, to name what kind of thing follows. Optional tone adds a diagram-colour dot." code={`<Eyebrow tone="field">Field</Eyebrow>`}>
        <Eyebrow>The model</Eyebrow>
        <Eyebrow tone="field">Field</Eyebrow>
      </Specimen>
      <Specimen layout="stack" title="Lede" note="The standfirst under a heading, one or two sentences, light weight, capped to a readable measure." code={`<Lede>SRS builds portable semantic documents that both humans and AI can understand and use.</Lede>`}>
        <Lede>SRS builds portable semantic documents that both humans and AI can understand and use.</Lede>
      </Specimen>
      <Specimen layout="stack" title="SectionHeader" note="Eyebrow, heading and lede in one. Every section opens with it, so headings, rhythm and measure never vary by page. level picks h1, h2 or h3. glyph puts a glyph of the diagram vocabulary before the eyebrow, to say what kind of idea the section is about." code={`<SectionHeader eyebrow="Model" title="Knowledge with its meaning intact">\n  Typed fields, binary relations, declared containers.\n</SectionHeader>`}>
        <SectionHeader eyebrow="Model" title="Knowledge with its meaning intact">
          Typed fields, binary relations, declared containers.
        </SectionHeader>
        <SectionHeader glyph="field" eyebrow="01" title="Field">The atomic, reusable unit of meaning.</SectionHeader>
      </Specimen>
      <Specimen layout="stack" title="Prose" note="Wrapper for rendered markdown HTML. It styles the elements the markdown renderer produces, so no page ever styles its own text." code={`<Prose><Fragment set:html={html} /></Prose>`}>
        <Prose><Fragment set:html={proseSample} /></Prose>
      </Specimen>
      <Specimen title="Button" note="A link when given href, otherwise a button. One filled variant (primary), then secondary, ghost and mono for utility actions. size sm for tight places. Inside an ink band it re-colours itself." code={`<Button variant="primary" href="/model">Read the model</Button>`}>
        <Button variant="primary" href="#content">Primary</Button>
        <Button variant="secondary" href="#content">Secondary</Button>
        <Button variant="ghost" href="#content">Ghost</Button>
        <Button variant="mono" href="#content">Mono</Button>
        <Button variant="secondary" size="sm">Small</Button>
        <Button variant="primary" disabled>Disabled</Button>
      </Specimen>
      <Specimen ink title="Button on ink" note="The same component, in an ink band. There is no on-ink variant to remember: the band re-resolves the component tokens.">
        <Button variant="primary" href="#content">Primary</Button>
        <Button variant="secondary" href="#content">Secondary</Button>
        <Button variant="ghost" href="#content">Ghost</Button>
        <Button variant="mono" href="#content">Mono</Button>
      </Specimen>
      <Specimen title="Tag" note="A status, told by border and fill and never by hue alone. Dashed is provisional, filled is agreed, struck through is terminal." code={`<Tag status="ratified" />`}>
        <Tag status="draft" />
        <Tag status="proposed" />
        <Tag status="active" />
        <Tag status="ratified" />
        <Tag status="superseded" />
        <Tag status="archived" />
      </Specimen>
      <Specimen title="Chip" note="A small mono pill for a name, a file kind or an identifier. The only pill on the site. Optional tone dot, optional href." code={`<Chip tone="record">decision@1</Chip>`}>
        <Chip>.srs</Chip>
        <Chip>.srsj</Chip>
        <Chip>.srspkg</Chip>
        <Chip>ext:lifecycle</Chip>
        <Chip tone="record">decision@1</Chip>
        <Chip href="#content">As a link</Chip>
      </Specimen>
      <Specimen layout="grid" title="CodeSample" note="Real structure, highlighted at build time and mapped to tokens, so it follows light, dark and ink. Show the JSON, the command, the file name. filename sets the mono bar." code={`<CodeSample filename="records/decision-7c2e9f41.json" lang="json" code={json} />`}>
        <CodeSample filename="records/decision-7c2e9f41.json" lang="json" code={recordJson} />
        <CodeSample filename="relations/3f6a1d90.json" lang="json" code={relationJson} />
        <CodeSample filename="shell" lang="bash" code={`srs repo validate --repo ./team-notes\nsrs record list --repo ./team-notes --type com.example.team/decision`} />
      </Specimen>
      <Specimen ink layout="stack" title="CodeSample on ink" note="The same sample on an ink band.">
        <CodeSample filename="relations/3f6a1d90.json" lang="json" code={relationJson} />
      </Specimen>
      <Specimen layout="stack" title="Quote" note="For the owner's phrasings and charter sentences, quoted faithfully. size md, lg or xl (the one line a page turns on); cite is the mono attribution." code={`<Quote size="lg" cite="The governing core">SRS preserves semantic sovereignty through portable data.</Quote>`}>
        <Quote size="xl">SRS preserves semantic sovereignty through portable data.</Quote>
        <Quote size="lg" cite="The governing core">SRS preserves semantic sovereignty through portable data.</Quote>
        <Quote cite="Standing principle">Records are the source of truth. Rendered documents are projections of those records: derived, never authoritative.</Quote>
      </Specimen>
      <Specimen layout="stack" title="Pronunciation" note="The name lockup: srs, pronounced source. The o is a ring in the record colour, because records are the source. size lg for the front door, md in running content." code={`<Pronunciation size="lg" />`}>
        <Pronunciation size="lg" />
        <Pronunciation size="md" />
      </Specimen>
    </div>
  </Section>

  <!-- CARDS -->
  <Section id="cards" variant="page">
    <SectionHeader eyebrow="Components" title="Cards">
      Containers for one idea, one record or one project.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="grid" title="RecordCard" note="A record shown as a thing: an ink header with the mono id, the type as namespace/name@version and the status, over label and value rows. It is the key visual of the product. Mark required fields." code={`<RecordCard id="7c2e9f41" type="com.example.team/decision@1" title="Review the budget weekly" status="ratified" fields={[...]} />`}>
        <RecordCard
          id="7c2e9f41"
          type="com.example.team/decision@1"
          title="Review the budget weekly"
          status="ratified"
          fields={[
            { label: "Title", value: "Review the budget weekly", required: true },
            { label: "Outcome", value: "Agreed for one quarter, then revisit", required: true },
            { label: "Rationale", value: "Spending drifted twice last year without anyone noticing." },
          ]}
        />
        <RecordCard
          id="b19d4e07"
          type="com.example.team/risk@1"
          title="Single point of failure in the release process"
          status="draft"
          fields={[
            { label: "Title", value: "Single point of failure in the release process", required: true },
            { label: "Mitigation", value: "Not yet decided" },
          ]}
        />
      </Specimen>
      <Specimen layout="grid" title="ConceptCard" note="One idea of the model: a glyph from the diagram vocabulary, a mono kind label, a title and a short explanation. With href the whole card is the link." code={`<ConceptCard kind="Field" glyph="field" title="Field">An atomic, reusable unit of meaning.</ConceptCard>`}>
        <ConceptCard kind="Field" glyph="field" title="Field">An atomic, reusable unit of meaning with a stable id, a name and a version. Different meaning is a different Field.</ConceptCard>
        <ConceptCard kind="Record" glyph="record" title="Record" href="#cards">A typed instance: values for the fields of one Type, bound to a specific version of it.</ConceptCard>
        <ConceptCard kind="Relation" glyph="relation" title="Relation">A typed edge between two things, read source, type, target.</ConceptCard>
        <ConceptCard kind="Container" glyph="structure" title="Container">A declared selection with an ordered outline. Membership is declared, never derived.</ConceptCard>
      </Specimen>
      <Specimen layout="grid" title="ProjectCard" note="One of the four projects, described as a kind of technology. A mono kind label, the name, a tagline, what it is, who it is for and what it makes possible, what it depends on (the relation links sit above the card's own link), its technologies as chips, and a link. All but the kind, name and link are optional. level is h3 in a grid and h2 when the card opens a band. The whole card is the target." code={`<ProjectCard name="srs-rust" kind="Reference engine" href="https://github.com/the-greenman/srs-rust" tagline="..." audience="..." makes="..." relations={[...]} tags={["MIT or Apache-2.0"]}>...</ProjectCard>`}>
        <ProjectCard name="srs" kind="Open standard" href="https://github.com/the-greenman/srs" tags={["JSON Schema", "Apache-2.0"]}>An open, implementation-independent standard for portable semantic documents, authored as its own data.</ProjectCard>
        <ProjectCard
          name="srs-rust"
          kind="Reference engine"
          href="https://github.com/the-greenman/srs-rust"
          tagline="One core behind a CLI, WebAssembly bindings and an MCP server."
          audience="Engineers who script, validate or embed SRS."
          makes="Every client gets the same answer, because the logic exists once."
          relations={[{ label: "Depends on", targets: [{ label: "srs", href: "#cards" }] }]}
          tags={["MIT or Apache-2.0"]}
        >A library-first engine: one core behind a CLI with a stable JSON contract, WASM bindings and an MCP server.</ProjectCard>
        <ProjectCard name="srs-web" kind="Browser editor" href="https://github.com/the-greenman/srs-web" tags={["WASM", "Client-side"]}>Edits SRS repositories entirely in the browser, against storage you own, with an agents panel.</ProjectCard>
        <ProjectCard name="srs-vscode" kind="VS Code extension" href="https://github.com/the-greenman/srs-vscode" tags={["TypeScript"]}>Tree and navigator views, validate on save, preview and a relation graph, over the srs binary.</ProjectCard>
      </Specimen>
      <Specimen layout="stack" title="PrincipleItem" note="One principle: an optional number above a title, its one-sentence statement (claim) and the explanation. Keep the charter's wording as given. It works in a column of any width, so set several in a grid. level is h3 in a list and h2 when the item opens a band." code={`<PrincipleItem number="01" title="Data sovereignty" claim="The people who create knowledge own it.">...</PrincipleItem>`}>
        <div class="grid grid--fit grid--lg grid--gap-md">
          <PrincipleItem number="01" title="Data sovereignty" claim="The people who create knowledge own it.">Sovereignty is structural, not aspirational. A repository is a folder of plain JSON files.</PrincipleItem>
          <PrincipleItem number="02" title="Decision sovereignty" claim="Groups decide for themselves.">SRS records what was decided and why. It never takes the decision.</PrincipleItem>
          <PrincipleItem number="03" title="No engineered control hierarchy" claim="Structure describes knowledge, never authority.">A relation is a claim about knowledge, not control flow.</PrincipleItem>
        </div>
      </Specimen>
      <Specimen layout="stack" title="FeatureGrid" note="A ruled grid of short parallel points: optional glyph and mono label, a title and a sentence. columns is 2, 3 or 4." code={`<FeatureGrid columns={3} items={[{ eyebrow: "Field", glyph: "field", title: "...", body: "..." }]} />`}>
        <FeatureGrid
          items={[
            { eyebrow: "Field", glyph: "field", title: "Meaning travels with the definition", body: "AI guidance lives with the field, not in an application's prompt." },
            { eyebrow: "Record", glyph: "record", title: "Required fields mean nothing is half-formed", body: "A type says what must be present before knowledge can be transferred." },
            { eyebrow: "Relation", glyph: "relation", title: "Edges are claims", body: "Strictly binary and typed, with one stored direction." },
          ]}
        />
      </Specimen>
      <Specimen layout="stack" title="PrincipleItem: held pair" note="With poles, a principle becomes a held pair: two ideas kept without choosing between them, set as two poles either side of one seam, the divided disc that both divides and joins, with the claim and the explanation centred under both. The poles are two fields of the record (pole_a and pole_b), never read out of the title; the title stays the heading's accessible name." code={`<PrincipleItem title="Fixed meaning, changing state" poles={["Fixed meaning", "Changing state"]} claim="...">...</PrincipleItem>`}>
        <PrincipleItem title="Fixed meaning, changing state" poles={["Fixed meaning", "Changing state"]} claim="A definition never changes underneath the records that use it, and records still move through states.">
          <p>Field semantics are immutable and a Record binds to an exact Type version, so what a value means is fixed. State is separate.</p>
        </PrincipleItem>
        <PrincipleItem title="Declared, never derived" poles={["Declared", "Never derived"]} claim="Membership is declared, never derived.">
          <p>What a container holds is what it says it holds, in its own ordered list.</p>
        </PrincipleItem>
      </Specimen>
      <Specimen layout="stack" title="RelationList" note="The relations of a record read as a sentence: the relation's own label, and its targets as chips in the relation colour, linked where the target is on the site. Used inside ConceptEntry and ProjectCard." code={`<RelationList relations={[{ label: "Depends on", targets: [{ label: "Field", href: "/model#field" }] }]} />`}>
        <RelationList relations={[{ label: "Depends on", targets: [{ label: "Field", href: "#cards" }, { label: "Type" }] }]} />
      </Specimen>
      <Specimen layout="bare" title="ConceptEntry" note="One idea of the model as a chapter: a margin column with the number, glyph, title, one-line summary, relations and a reference link, beside the explanation (the slot) and a real example as JSON. The margin column stays in view while the explanation scrolls (960px and up); below that everything stacks. One concept per band." code={`<ConceptEntry number="01" glyph="field" title="Field" summary="..." example={json} reference={{ href, text }}>...</ConceptEntry>`}>
        <ConceptEntry
          number="05"
          glyph="record"
          title="Record and graduation"
          summary="Knowledge bound to a Type, and how a Note becomes one."
          example={recordJson}
          reference={{ href: "#cards", text: "srs.semanticops.com/schema/2.0/record.json" }}
          relations={[{ label: "Depends on", targets: [{ label: "Type", href: "#cards" }] }]}
        >
          <p>A Record is an instance of a Type. <code>typeId</code> and <code>typeVersion</code> select the Type, and <code>fieldValues</code> maps Field names to values.</p>
          <p>Graduation turns a Note into one or more Records, each linked to its Note by a <code>derived-from</code> relation. The Note is preserved.</p>
        </ConceptEntry>
      </Specimen>
    </div>
  </Section>

  <!-- PAGE ASSEMBLY -->
  <Section id="assembly">
    <SectionHeader eyebrow="Pages" title="Page assembly">
      The pages are the data laid out by components. The assemblers below have no look of their own: every look comes from the presentation map, and every fact from the records.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="stack" title="Presentation map" note="src/lib/presentation.ts is the one place a record's slug is paired with how it is shown: the band surface (paper, page or ink), a diagram, a glyph, a lede set as a quotation, a principle as a headline or a pair. page:slug overrides it for one page. A slug with no entry takes the default of its type. To show a record differently, change one line here and nothing else." code={`"idea": { band: "ink", visual: ProjectionFan },\n"record": { band: "ink", glyph: "record", visual: MaturityLadder },\n"home:governing-core": { band: undefined },`}>
        <Prose measure="wide">
          <table>
            <thead><tr><th>Slug</th><th>Band</th><th>Diagram</th><th>Glyph</th><th>Form</th></tr></thead>
            <tbody>
              {lookRows.map((r) => <tr><td><code>{r.key}</code></td><td>{r.band}</td><td>{r.visual}</td><td>{r.glyph}</td><td>{r.form}</td></tr>)}
            </tbody>
          </table>
        </Prose>
      </Specimen>
      <Specimen layout="bare" title="PageBands and Entry" note="PageBands turns a page's entries, in the data's order, into full-bleed bands: a section, a concept or any entry whose look names a surface opens one, and the entries after it are its items, grouped by form (a grid of ProjectCards, a grid of principles, a stack of pairs). Paper and page take turns, and ink only where the map asks. Entry draws one record by its type and look, gives it id={slug} and the diagram its look names. Figure numbers count up the page." code={`<PageBands entries={page.entries} page={page.key} />`}>
        <PageBands bands={demoBands} page="styleguide" />
      </Specimen>
    </div>
  </Section>

  <!-- MARKS -->
  <Section id="marks">
    <SectionHeader eyebrow="Identity" title="Marks, for the owner to choose">
      Candidates for the SRS mark and the SemanticOps mark, each at the sizes it has to work at, on paper and on ink. The S-wave runs top to bottom so the dividing line reads as an S, for source. It is the srs-web geometry turned upright.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="stack" title="SrsMark: line" note="A disc with the S-wave drawn through it, top to bottom, so it reads as an S. The srs-web mark turned upright, and the clearest at 16px." code={`<SrsMark variant="line" size={24} />`}>
        <MarkRow mark="srs" variant="line" />
      </Specimen>
      <Specimen layout="stack" title="SrsMark: halves (recommended)" note="The same disc and the same S, with the two regions filled and each holding a seed of the other, and the S drawn as a line over the seam so it reads as a letter. It reads as one source and two readers, people and agents, and it is the shape the TwoSurfaces diagram explains. Recommended as the primary mark." code={`<SrsMark variant="halves" size={24} />`}>
        <MarkRow mark="srs" variant="halves" />
      </Specimen>
      <Specimen title="SrsMark: S line colours" note="The S line is a small vermilion accent by default (the --dg-divide token, the owner's choice), lit on dark when the mark inverts. line takes another diagram tone for display uses, or none for the plain halves." code={`<SrsMark variant="halves" line="structure" size={96} />`}>
        <div class="cluster">
          <SrsMark variant="halves" size={96} />
          <SrsMark variant="halves" line="structure" size={96} />
          <SrsMark variant="halves" line="relation" size={96} />
          <SrsMark variant="halves" line="none" size={96} />
        </div>
      </Specimen>
      <Specimen layout="stack" title="SrsMark: ring" note="The halves with ring-node seeds, inside a broken ring. Too fine for 16px; use it large, as the SemanticOps lockup or a display mark." code={`<SrsMark variant="ring" size={96} />`}>
        <MarkRow mark="srs" variant="ring" />
      </Specimen>
      <Specimen layout="stack" title="SemanticOpsMark: network" note="For the ecosystem rather than SRS itself. A broken ring, six records, hairline relations and a target centre: a repository drawn in the site's own vocabulary." code={`<SemanticOpsMark variant="network" size={48} />`}>
        <MarkRow mark="semanticops" variant="network" sizes={[128, 48, 32]} />
      </Specimen>
      <Specimen layout="stack" title="SemanticOpsMark: orbit" note="A broken ring around one large record, with a satellite on the ring. Simpler and bolder, and it holds up better small." code={`<SemanticOpsMark variant="orbit" size={48} />`}>
        <MarkRow mark="semanticops" variant="orbit" sizes={[128, 48, 32, 24]} />
      </Specimen>
      <Specimen title="Wordmark and lockups" note="SemanticOps holds two weights in one word: Semantic in regular, Ops in bold. srs is lowercase and medium. The mark sits to the left at the cap height of the word." code={`<SrsMark variant="halves" size={32} /><Wordmark size="md" />`}>
        <Wordmark size="lg" />
        <Wordmark size="md" />
        <Wordmark size="sm" />
        <Wordmark name="srs" size="lg" />
        <span class="cluster cluster--md"><SrsMark variant="halves" size={40} /><Wordmark size="lg" /></span>
        <span class="cluster cluster--md"><SemanticOpsMark variant="network" size={40} /><Wordmark size="lg" /></span>
      </Specimen>
    </div>
  </Section>

  <!-- DIAGRAM PRIMITIVES -->
  <Section id="primitives" variant="page">
    <SectionHeader eyebrow="Diagrams" title="Diagram primitives">
      Every diagram is composed from these, and nothing else draws circles or lines. A broken ring is a boundary, a flat disc is a record, a ring-node is a field, a thin line is a relation, a target is identity.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen title="Disc" note="A flat filled disc: a record (vermilion, the default), a note (gold) or a neutral part (ink). hollow draws only the ring, for derived output. label and labelPosition set short text. Boundaries, fields and relations have their own shapes below, so they are never drawn as discs." code={`<Disc cx={40} cy={50} r={20} tone="record" label="record" />`}>
        <Canvas id="sg-disc" viewBox="0 0 360 120" title="Discs" desc="Four discs: a vermilion record, a gold note, a neutral ink disc and a hollow ink ring for derived output.">
          <Disc cx={40} cy={44} r={20} tone="record" label="record" />
          <Disc cx={130} cy={44} r={20} tone="note" label="note" />
          <Disc cx={220} cy={44} r={20} tone="ink" label="ink" />
          <Disc cx={310} cy={44} r={20} tone="ink" hollow label="hollow" />
        </Canvas>
      </Specimen>
      <Specimen title="RingNode" note="A ring around a smaller ring or a dot: a field (green, the default) or, in neutral ink, a part with no idea of its own. inner is dot, ring or none. Its middle is pale so a line can end at it." code={`<RingNode cx={40} cy={44} r={20} inner="dot" />`}>
        <Canvas id="sg-ringnode" viewBox="0 0 420 120" title="Ring-nodes" desc="Field ring-nodes in green with a dot, with a ring and with nothing inside, then a neutral ink ring-node and a small green one.">
          <RingNode cx={40} cy={44} r={20} inner="dot" label="dot" />
          <RingNode cx={116} cy={44} r={20} inner="ring" label="ring" />
          <RingNode cx={192} cy={44} r={20} inner="none" label="none" />
          <RingNode cx={268} cy={44} r={20} tone="ink" inner="dot" label="ink" />
          <RingNode cx={344} cy={44} r={12} inner="dot" label="small" />
        </Canvas>
      </Specimen>
      <Specimen title="BrokenRing" note="Thick segments with clean gaps: a boundary is drawn, not solid, because a container is a declared selection. segments and gap space it evenly; gaps places gap centres by angle. Never close the circle for a container." code={`<BrokenRing cx={60} cy={60} r={44} width={8} segments={6} gap={14} />`}>
        <Canvas id="sg-broken" viewBox="0 0 460 140" title="Broken rings" desc="Three broken blue rings: six segments, three segments with wide gaps, and a ring with gaps at chosen angles.">
          <BrokenRing cx={70} cy={66} r={50} segments={6} gap={14} />
          <BrokenRing cx={230} cy={66} r={50} segments={3} gap={30} />
          <BrokenRing cx={390} cy={66} r={50} gaps={[-90, 20, 150]} gap={[16, 30, 16]} />
        </Canvas>
      </Specimen>
      <Specimen title="Link" note="A relation line (khaki) with an optional mono label, which breaks the line with its halo. Reads source to target: the arrow points at the target. dashed, inset and width adjust it; tone ink draws a neutral action such as an edit, which is not a relation." code={`<Link x1={10} y1={40} x2={200} y2={40} arrow="end" label="precedes" />`}>
        <Canvas id="sg-link" viewBox="0 0 520 190" title="Relation lines" desc="Four khaki relation lines: plain, with an arrow, with a label and arrow, and dashed. Beside them a thick relation line, a neutral ink arrow pointing back and a medium relation arrow.">
          <Link x1={10} y1={24} x2={240} y2={24} />
          <Link x1={10} y1={64} x2={240} y2={64} arrow="end" />
          <Link x1={10} y1={104} x2={240} y2={104} arrow="end" label="precedes" />
          <Link x1={10} y1={144} x2={240} y2={144} dashed arrow="end" label="proposed" />
          <Link x1={280} y1={24} x2={510} y2={24} width={4} />
          <Link x1={280} y1={64} x2={510} y2={64} tone="ink" arrow="start" />
          <Link x1={280} y1={104} x2={510} y2={104} arrow="end" width={3} />
        </Canvas>
      </Specimen>
      <Specimen title="Target" note="Ring, fill, ring, dot: identity, or the core. The thing everything else is arranged around." code={`<Target cx={40} cy={44} r={24} label="core" />`}>
        <Canvas id="sg-target" viewBox="0 0 320 130" title="Targets" desc="Three target centres in increasing size.">
          <Target cx={50} cy={50} r={14} label="14" />
          <Target cx={140} cy={50} r={24} label="24" />
          <Target cx={250} cy={50} r={38} label="38" />
        </Canvas>
      </Specimen>
      <Specimen title="Knockout" note="The helper behind the gaps: a disc in the ground colour, drawn under a shape. Use it for shapes that are not discs." code={`<Knockout cx={100} cy={50} r={32} />`}>
        <Canvas id="sg-knockout2" viewBox="0 0 300 110" title="A knockout helper" desc="A khaki line is cut by a ground-coloured circle with a small record on top.">
          <Link x1={10} y1={55} x2={290} y2={55} width={3} />
          <Knockout cx={150} cy={55} r={34} />
          <Disc cx={150} cy={55} r={18} knockout={0} />
        </Canvas>
      </Specimen>
      <Specimen title="Halves" note="One disc divided by an S-shaped line, each region holding a seed of the other. The geometry of the SRS mark, and the two readers of one source. right picks which region is ink; seed is dot or ring." code={`<Halves cx={60} cy={60} r={48} right="ink" seed="dot" />`}>
        <Canvas id="sg-halves" viewBox="0 0 460 130" title="Halves" desc="Four discs divided by an S-shaped line: ink above with dot seeds, paper above with dot seeds, and both again with ring seeds.">
          <Halves cx={60} cy={62} r={48} right="ink" seed="dot" edge={2} />
          <Halves cx={170} cy={62} r={48} right="paper" seed="dot" edge={2} />
          <Halves cx={280} cy={62} r={48} right="ink" seed="ring" edge={2} />
          <Halves cx={390} cy={62} r={48} right="paper" seed="ring" edge={2} />
        </Canvas>
      </Specimen>
      <Specimen title="Cluster" note="A unit of knowledge with its parts: a broken ring, six parts, hairline relations and a target. Self-similar: open one part and it becomes a smaller cluster, which can open again. levels sets how many open; labels names the six parts, and the opened part's label sits beside it, clear of the zoom link." code={`<Cluster cx={160} cy={160} r={110} open={1} levels={2} labels={[...]} />`}>
        <Canvas id="sg-cluster" viewBox="0 0 560 330" title="A cluster that opens" desc="A broken ring of six records opens one part into a smaller ring of fields, and that into a smaller ring again.">
          <Cluster cx={160} cy={170} r={110} open={1} levels={2} />
        </Canvas>
      </Specimen>
      <Specimen title="Glyph" note="One small icon per idea, drawn from the primitives. The legend and the concept cards share it. Decorative: always pair it with text." code={`<Glyph kind="record" size={24} />`}>
        <span class="cluster"><Glyph kind="structure" size={28} /><span class="t-label">structure</span></span>
        <span class="cluster"><Glyph kind="record" size={28} /><span class="t-label">record</span></span>
        <span class="cluster"><Glyph kind="field" size={28} /><span class="t-label">field</span></span>
        <span class="cluster"><Glyph kind="relation" size={28} /><span class="t-label">relation</span></span>
        <span class="cluster"><Glyph kind="identity" size={28} /><span class="t-label">identity</span></span>
        <span class="cluster"><Glyph kind="note" size={28} /><span class="t-label">note</span></span>
        <span class="cluster"><Glyph kind="part" size={28} /><span class="t-label">part</span></span>
        <span class="cluster"><Glyph kind="derived" size={28} /><span class="t-label">derived</span></span>
      </Specimen>
      <Specimen layout="grid" title="Figure and Canvas" note="Figure is the chrome: a plate with an optional dot-grid ground, a mono figure number and a caption. The plate is a size container, so a diagram picks its wide or narrow layout from the room it has. Canvas is the svg: role img, title and description. motion plays the drawing-in on load (CSS only, off under reduced motion): a boundary draws, its parts pop in, the relations draw, then an arrowhead appears only after its line. Use it above the fold. Every label inside a Canvas sits on a ground-coloured halo (--dg-halo) wide enough to bridge a word space, so the dot grid never reads as a middot." code={`<Figure number={7} caption="A caption." grid motion><Canvas ...>...</Canvas></Figure>`}>
        <Figure number={7} caption="With the dot-grid ground." size="narrow">
          <Canvas id="sg-figure-a" viewBox="0 0 240 90" title="A record on a figure" desc="One record disc on a dot-grid plate.">
            <Disc cx={120} cy={45} r={22} />
          </Canvas>
        </Figure>
        <Figure number={8} caption="Without it." grid={false} size="narrow">
          <Canvas id="sg-figure-b" viewBox="0 0 240 90" title="A field on a plain plate" desc="One ring-node on a plain plate.">
            <RingNode cx={120} cy={45} r={22} />
          </Canvas>
        </Figure>
      </Specimen>
    </div>
  </Section>

  <!-- DIAGRAMS -->
  <Section id="diagrams">
    <SectionHeader eyebrow="Diagrams" title="Diagrams">
      Six diagrams, each composed from the primitives, each with a wide layout and a stacked narrow one that stays legible at 375px. Labels are props: Phase 2 feeds real content in. Resize the window to see the layouts switch.
    </SectionHeader>
    <div class="stack stack--md">
      <Specimen layout="bare" title="HeroCluster" note="The signature visual: a repository drawn as a broken ring, one record opening into its own cluster, and that into another. Layered and drillable. Every record carries its label, the one that opens included. It plays its drawing-in on load as one sequence: the ring, the records, the relations, then the cluster that opens. The narrow layout turns it so the same record opens downward. Props: labels (six record names), caption." code={`<HeroCluster labels={["decision", "claim", "task", "source", "risk", "rule"]} />`}>
        <HeroCluster number={1} id="sg-hero" />
      </Specimen>
      <Specimen layout="bare" title="ProjectionFan" note="Records fan out into projections. Edits go only into the records; every projection is derived. Props: outputs, edit, derived. Narrow layout hangs the outputs off one trunk." code={`<ProjectionFan outputs={["Markdown", "HTML", "JSON", "agent context"]} />`}>
        <ProjectionFan number={2} id="sg-fan" />
      </Specimen>
      <Specimen layout="bare" title="CapabilityStack" note="Core, one service, the CLI, WASM and MCP adapters, then the clients. A capability is implemented once, in the core. Clients add presentation, never semantics. Architecture is no colour meaning, so adapters are neutral ink ring-nodes and clients neutral ink discs; only the core keeps the target." code={`<CapabilityStack />`}>
        <CapabilityStack number={3} id="sg-stack" />
      </Specimen>
      <Specimen layout="bare" title="MaturityLadder" note="A note graduates into records, linked back by derived-from, and the note is kept. Props: note, records (one label each), relation." code={`<MaturityLadder records={["decision", "task", "task", "task", "risk", "risk"]} />`}>
        <MaturityLadder number={4} id="sg-ladder" />
      </Specimen>
      <Specimen layout="bare" title="RelationSentence" note="Seven rows reading source, type, target. Props: relations, a list of type and plain-words gloss." code={`<RelationSentence relations={[{ type: "precedes", gloss: "comes before" }]} />`}>
        <RelationSentence number={5} id="sg-relations" />
      </Specimen>
      <Specimen layout="bare" title="TwoSurfaces" note="One source, projected twice: the human site and the agent site, drawn as the two halves of one disc. Props: source, human, agent, project." code={`<TwoSurfaces />`}>
        <TwoSurfaces number={6} id="sg-two" />
      </Specimen>
    </div>
  </Section>

  <Section variant="ink" id="ink-diagram">
    <SectionHeader eyebrow="Diagrams" title="On an ink band">
      The same diagram on ink: the band re-resolves the diagram colours to their lit values, and knockouts follow the ground.
    </SectionHeader>
    <HeroCluster number={9} id="sg-hero-ink" motion={false} />
  </Section>

