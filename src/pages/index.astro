---
import Base from "../layouts/Base.astro";
import AgentEdition from "../components/AgentEdition.astro";
import Button from "../components/Button.astro";
import Pronunciation from "../components/Pronunciation.astro";
import Prose from "../components/Prose.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SrsMark from "../components/SrsMark.astro";
import HeroCluster from "../components/diagram/HeroCluster.astro";
import PageBands from "../components/page/PageBands.astro";
import { toBands } from "../lib/bands";
import { agentEdition, getPage, homePage, site } from "../lib/content";
import { markdown, markdownInline } from "../lib/markdown";
import { lookFor } from "../lib/presentation";

/**
 * Home is a landing page, so its first band is composed by hand: the mark, the name lockup, the
 * hero record's words and the signature diagram. Which record that is, and where its calls to
 * action lead, are looks in the presentation map (`hero`, `actions`). Everything below it is the
 * same band assembly as every other page. The hero is the one entry taken out of the flow; the
 * rest keep the data's order.
 */
const hero = homePage.entries.find((e) => lookFor(homePage.key, e.slug).hero);
if (hero?.type !== "section") throw new Error("home has no hero section in the presentation map: run npm run source, or fix src/lib/presentation.ts");
const actions = (lookFor(homePage.key, hero.slug).actions ?? []).map(getPage);
const bands = toBands(homePage.entries.filter((e) => e !== hero), homePage.key);
---

<Base fullTitle={`${site.title}: ${hero.fields.title}`} description={homePage.summary}>
  <Section id={hero.slug} width="wide">
    <div class="split">
      <div class="stack stack--md">
        <div class="cluster cluster--md">
          <SrsMark variant="halves" size={56} />
          <Pronunciation size="md" />
        </div>
        <SectionHeader level="h1" eyebrow={hero.fields.eyebrow} title={hero.fields.title}>
          <Fragment set:html={await markdownInline(hero.fields.lede)} />
        </SectionHeader>
        {hero.fields.body && <Prose><Fragment set:html={await markdown(hero.fields.body)} /></Prose>}
        <div class="cluster cluster--md">
          {actions.map((p, i) => <Button href={p.href} variant={i === 0 ? "primary" : "secondary"}>{p.title}</Button>)}
        </div>
        <AgentEdition {...agentEdition(homePage.key)} />
      </div>
      <HeroCluster number={1} id="fig-hero" />
    </div>
  </Section>
  <PageBands {bands} page={homePage.key} figureStart={2} />
</Base>
