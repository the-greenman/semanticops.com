---
/**
 * One principle: a number, a title, its one-sentence statement and the explanation (the
 * slot). Set several in a grid for a list of principles. Statements are quoted faithfully from
 * the charter, so keep the wording as given. The number sits above the title, so an item works
 * in a column of any width.
 */
interface Props {
  /** The ordinal, as text: "01". */
  number?: string;
  title: string;
  /** The one-sentence statement, quoted as given. */
  claim?: string;
  /** Anchor target. */
  id?: string;
  class?: string;
}

const { number, title, claim, id, class: className } = Astro.props;
---

<article {id} class:list={["principle", className]}>
  {number && <p class="principle__no t-label">{number}</p>}
  <div class="principle__main">
    <h3 class="principle__title">{title}</h3>
    {claim && <p class="principle__claim">{claim}</p>}
    <div class="principle__body"><slot /></div>
  </div>
</article>

<style>
  @layer components {
    .principle {
      display: grid;
      gap: var(--space-xs);
      align-content: start;
      padding: var(--space-md) 0;
      border-top: var(--rule);
    }

    .principle__no {
      margin: 0;
    }

    .principle__title {
      margin: 0 0 var(--space-xs);
      font-size: var(--size-lg);
      letter-spacing: var(--tracking-snug);
    }

    .principle__claim {
      max-width: 40rem;
      margin: 0 0 var(--space-xs);
      font-size: var(--size-md);
      line-height: var(--leading-snug);
      color: var(--color-text-strong);
    }

    .principle__body {
      max-width: 40rem;
      color: var(--color-muted-strong);
    }
  }
</style>
