---
import Chip from "./Chip.astro";
import RelationList from "./RelationList.astro";

/**
 * One of the four projects, described as a kind of technology rather than a status.
 * A mono kind label, the project name, a one-line tagline, what it is (the slot), who it is
 * for and what it makes possible, what it depends on (linked), its technologies as chips,
 * and a link. The whole card is the link target; the relation links sit above it.
 */
interface Props {
  /** The project name: srs, srs-rust, srs-web, srs-vscode. */
  name: string;
  /** What kind of thing it is: "Open standard", "Reference engine". */
  kind: string;
  href: string;
  /** One line under the name. */
  tagline?: string;
  /** Who it is for. */
  audience?: string;
  /** What it makes possible. */
  makes?: string;
  /** What it depends on, as relations with linked targets. */
  relations?: { label: string; targets: { label: string; href?: string }[] }[];
  /** Short mono chips: licence, language, runtime. */
  tags?: string[];
  /** The label of the link. */
  cta?: string;
  /** The heading level: h3 in a grid, h2 when the card opens a band. */
  level?: "h2" | "h3";
  /** Anchor target. */
  id?: string;
  class?: string;
}

const { name, kind, href, tagline, audience, makes, relations = [], tags = [], cta = "View on GitHub", level = "h3", id, class: className } = Astro.props;
const Heading = level;
const facts = [
  { label: "For", text: audience },
  { label: "Makes possible", text: makes },
].filter((f) => f.text);
---

<article {id} class:list={["project-card", className]}>
  <p class="t-label">{kind}</p>
  <Heading class="project-card__name"><a class="project-card__link" href={href}>{name}</a></Heading>
  {tagline && <p class="project-card__tagline">{tagline}</p>}
  <div class="project-card__body"><slot /></div>
  {
    facts.length > 0 && (
      <dl class="project-card__facts">
        {facts.map((f) => (
          <div>
            <dt class="t-label">{f.label}</dt>
            <dd>{f.text}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {relations.length > 0 && <RelationList class="project-card__relations" {relations} />}
  {tags.length > 0 && <ul class="project-card__tags">{tags.map((t) => <li><Chip>{t}</Chip></li>)}</ul>}
  <p class="project-card__cta t-label" aria-hidden="true">{cta}</p>
</article>

<style>
  @layer components {
    .project-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      padding: var(--space-md) var(--space-sm) var(--space-sm);
      border: 1px solid var(--card-border);
      background: var(--card-bg);
    }

    .project-card:hover {
      border-color: var(--card-hover-border);
    }

    .project-card__name {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--size-lg);
      font-weight: var(--weight-medium);
      letter-spacing: var(--tracking-tight);
    }

    .project-card__link {
      color: inherit;
      text-decoration: none;
    }

    .project-card__link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    /* The whole item is the target, so the focus ring is drawn on the overlay and not on the small link text. */
    .project-card__link:focus-visible {
      outline: none;
    }

    .project-card__link:focus-visible::after {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }

    .project-card__tagline {
      margin: 0;
      font-size: var(--size-md);
      line-height: var(--leading-snug);
      color: var(--color-text-strong);
    }

    .project-card__body {
      flex: 1;
      color: var(--color-muted-strong);
    }

    .project-card__facts {
      display: grid;
      gap: var(--space-sm);
      margin: 0;
      font-size: var(--size-sm);
    }

    .project-card__facts dt {
      margin-bottom: var(--space-2xs);
    }

    .project-card__facts dd {
      margin: 0;
      color: var(--color-muted-strong);
    }

    /* The relation links are real links inside a card that is itself a link: lift them above its overlay. */
    .project-card__relations {
      position: relative;
      z-index: var(--z-raised);
    }

    .project-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .project-card__cta {
      margin: 0;
      padding-top: var(--space-xs);
      border-top: var(--rule-soft);
    }

    .project-card:hover .project-card__cta {
      color: var(--color-text-strong);
    }
  }
</style>
