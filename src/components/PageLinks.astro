---
/**
 * Where to read next: the other pages, each a title and its summary, the whole item a link.
 * The pages and their summaries come from the data, so a page added to the repository
 * appears here without a code change.
 */
interface Props {
  items: { href: string; title: string; summary: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={["page-links", className]}>
  {
    items.map((item) => (
      <li class="page-links__item">
        <h3 class="page-links__title">
          <a class="page-links__link" href={item.href}>
            {item.title}
          </a>
          <span class="page-links__arrow" aria-hidden="true">
            →
          </span>
        </h3>
        <p class="page-links__summary">{item.summary}</p>
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .page-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
      gap: var(--space-md);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .page-links__item {
      position: relative;
      padding-top: var(--space-sm);
      border-top: var(--rule);
    }

    .page-links__item:hover {
      border-top-color: var(--color-text-strong);
    }

    .page-links__title {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-sm);
      margin: 0 0 var(--space-xs);
      font-size: var(--size-lg);
      letter-spacing: var(--tracking-snug);
    }

    .page-links__link {
      color: inherit;
      text-decoration: none;
    }

    /* The whole item is the target. */
    .page-links__link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    /* The whole item is the target, so the focus ring is drawn on the overlay and not on the small link text. */
    .page-links__link:focus-visible {
      outline: none;
    }

    .page-links__link:focus-visible::after {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }

    .page-links__arrow {
      font-family: var(--font-mono);
      color: var(--color-muted);
    }

    .page-links__summary {
      margin: 0;
      font-size: var(--size-sm);
      color: var(--color-muted-strong);
    }
  }
</style>
