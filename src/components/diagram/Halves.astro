---
import { round } from "./geometry";
import type { Tone } from "./tones";

/**
 * One disc divided by an S-shaped line into two regions, each holding a seed of the
 * other. The line both divides and joins: it is the same line on either side. This is
 * the geometry of the SRS mark (in a 24 box: M12 1.25 a5.375 5.375 0 0 0 0 10.75
 * a5.375 5.375 0 0 1 0 10.75), the line running top to bottom so it reads as an S,
 * with the two regions filled. The two readers of one source: people on the left,
 * agents on the right. The geometry descends from the taijitu; the site never says so,
 * it only draws it.
 */
interface Props {
  cx: number;
  cy: number;
  r: number;
  /** Which tone fills the right region. The left region takes the other. */
  right?: "ink" | "paper";
  /** The seed in each region: a dot, or a ring-node. */
  seed?: "dot" | "ring";
  /** The S drawn as a line over the seam: grey (default), a diagram tone, or none. */
  line?: "grey" | "none" | Tone;
  /** Outline width. Defaults to a tenth of the radius. */
  edge?: number;
  class?: string;
}

const { cx, cy, r, right = "ink", seed = "dot", line = "grey", edge, class: className } = Astro.props;

const left = right === "ink" ? "paper" : "ink";
const h = r / 2;
const top = round(cy - r);
const bottom = round(cy + r);
// The S runs top to bottom, bulging left above the centre and right below it. The right
// region: the big right arc down, then back up the S (reversed).
const regionRight = `M${cx} ${top}A${r} ${r} 0 0 1 ${cx} ${bottom}A${h} ${h} 0 0 0 ${cx} ${cy}A${h} ${h} 0 0 1 ${cx} ${top}Z`;
const w = edge ?? Math.max(0.6, r * 0.1);
const sr = r * 0.14;
// Each region's head is a half-radius circle: the right region's at the top, the left's at
// the bottom. The seed in each head takes the other region's tone.
const seeds = [
  { x: cx, y: round(cy - h), tone: left },
  { x: cx, y: round(cy + h), tone: right },
];
// The S itself, drawn as one line over the seam: grey by default, or a diagram tone. Its
// butt ends sit on the rim's centre line, so the rim covers them.
const divide = `M${cx} ${top}A${h} ${h} 0 0 0 ${cx} ${cy}A${h} ${h} 0 0 1 ${cx} ${bottom}`;
const lw = r * 0.093;
---

<g class:list={["dg-halves", className]}>
  <circle class={`dg-half--${left}`} {cx} {cy} {r}></circle>
  <path class={`dg-half--${right}`} d={regionRight}></path>
  {line !== "none" && <path class:list={["dg-divide", line !== "grey" && `dg-tone--${line}`]} d={divide} stroke-width={lw}></path>}
  {
    seeds.map((s) =>
      seed === "ring" ? (
        <>
          <circle class={`dg-seed-ring--${s.tone}`} cx={s.x} cy={s.y} r={sr * 1.5} stroke-width={Math.max(0.5, sr * 0.45)}></circle>
          <circle class={`dg-seed--${s.tone}`} cx={s.x} cy={s.y} r={sr * 0.55}></circle>
        </>
      ) : (
        <circle class={`dg-seed--${s.tone}`} cx={s.x} cy={s.y} r={sr}></circle>
      ),
    )
  }
  <circle class="dg-half-edge" {cx} {cy} {r} stroke-width={w}></circle>
</g>
