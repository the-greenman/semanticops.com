---
import { LINE_WEIGHT, round, trim } from "./geometry";
import type { Tone } from "./tones";

/**
 * A relation line between two points, with an optional mono label (the relation type)
 * that breaks the line with its halo. Reads source to target: the arrow, when present,
 * points at the target. When it draws in, the arrowhead appears only after its line.
 */
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  tone?: Tone;
  /** Relation type, or any short label, set on the line. */
  label?: string;
  /** Where along the line the label sits, 0 to 1. */
  labelAt?: number;
  arrow?: "end" | "start" | "none";
  dashed?: boolean;
  /** Nominal stroke width, drawn LINE_WEIGHT heavier (geometry.ts). */
  width?: number;
  /** Shorten the line at each end so it stops at the edge of a node. */
  inset?: number;
  insetEnd?: number;
  /** Animate the line drawing in, after `delay` seconds (and its arrowhead fading in after it). */
  draw?: boolean;
  delay?: number;
  class?: string;
}

const { x1, y1, x2, y2, tone = "relation", label = "", labelAt = 0.5, arrow = "none", dashed = false, width: nominal = 2, inset = 0, insetEnd, draw = false, delay = 0, class: className } = Astro.props;
const width = nominal * LINE_WEIGHT;

const [a, b] = trim({ x: x1, y: y1 }, { x: x2, y: y2 }, inset, insetEnd ?? inset);
const ang = Math.atan2(b.y - a.y, b.x - a.x);
const head = 5 + width * 1.5;
const tip = (p: { x: number; y: number }, dir: number) => {
  const l = { x: p.x - head * Math.cos(dir - 0.42), y: p.y - head * Math.sin(dir - 0.42) };
  const r = { x: p.x - head * Math.cos(dir + 0.42), y: p.y - head * Math.sin(dir + 0.42) };
  return `${round(p.x)},${round(p.y)} ${round(l.x)},${round(l.y)} ${round(r.x)},${round(r.y)}`;
};
const mid = { x: round(a.x + (b.x - a.x) * labelAt), y: round(a.y + (b.y - a.y) * labelAt) };
const animate = draw && !dashed;
const len = round(Math.hypot(b.x - a.x, b.y - a.y) + width);
---

<g class:list={["dg-link", `dg-tone--${tone}`, className]} style={animate ? `--dg-delay:${delay}s` : undefined}>
  <line
    class:list={["dg-line", dashed && "dg-line--dashed", animate && "dg-draw"]}
    x1={a.x}
    y1={a.y}
    x2={b.x}
    y2={b.y}
    stroke-width={width}
    style={animate ? `--dg-len:${len}` : undefined}
  ></line>
  {arrow === "end" && <polygon class:list={["dg-arrow", animate && "dg-arrow--late"]} points={tip(b, ang)}></polygon>}
  {arrow === "start" && <polygon class:list={["dg-arrow", animate && "dg-arrow--late"]} points={tip(a, ang + Math.PI)}></polygon>}
  {
    label && (
      <text class="dg-text dg-text--muted" x={mid.x} y={mid.y} text-anchor="middle" dominant-baseline="central">
        {label}
      </text>
    )
  }
</g>
