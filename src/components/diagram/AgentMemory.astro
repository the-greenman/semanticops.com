---
import Actor from "./Actor.astro";
import BrokenRing from "./BrokenRing.astro";
import Canvas from "./Canvas.astro";
import Disc from "./Disc.astro";
import Figure from "./Figure.astro";
import Link from "./Link.astro";
import { wrap } from "./geometry";

/**
 * A real project memory, written by agents for agents. The system map is a container of
 * component records, one for each part of the system. A decision, a convention and a trap are
 * records of their own that point at the component they are about, and the trap points at two.
 */
interface Props {
  number?: number;
  caption?: string;
  id?: string;
  /** The container's title: the layer that holds the components. */
  map?: string;
  /** The two components. The decision is about the first, the convention about the second, the trap about both. */
  first?: string;
  second?: string;
  decision?: string;
  convention?: string;
  trap?: string;
  decisionKind?: string;
  conventionKind?: string;
  trapKind?: string;
  /** Lifecycle states, shown beside the kind. A convention has no lifecycle. */
  decisionState?: string;
  trapState?: string;
  appliesTo?: string;
  agent?: string;
  grid?: boolean;
  motion?: boolean;
}

const {
  number = 7,
  caption = "The system map holds one record for each part of the system. A decision, a convention and a trap each point at the part they are about, and one record can point at two. Where a record stands is its state: the decision is accepted, the trap still open.",
  id = "dg-agent-memory",
  map = "System map",
  first = "srs",
  second = "srs-rust",
  decision = "SRS principle: one specific way per goal",
  convention = "Every branch traces to an issue; every PR links it",
  trap = "Stale sibling checkouts give false greens",
  decisionKind = "decision",
  conventionKind = "convention",
  trapKind = "trap",
  decisionState = "accepted",
  trapState = "open",
  appliesTo = "applies-to",
  agent = "written by an agent",
  grid = true,
  motion = false,
} = Astro.props;

const title = "A project memory kept by agents";
const desc = `A broken ring, the container ${map}, holds two component records, ${first} and ${second}. Outside it are three records, each marked with a notched square for an agent: a ${decisionKind} in state ${decisionState}, "${decision}", points at ${first} with ${appliesTo}; a ${conventionKind}, "${convention}", points at ${second}; a ${trapKind} in state ${trapState}, "${trap}", points at both ${first} and ${second}.`;
// The trap sits between the other two in the wide layout and first in the narrow one, so no line crosses a row.
const rows = {
  decision: { kind: `${decisionKind} · ${decisionState}`, name: decision },
  convention: { kind: conventionKind, name: convention },
  trap: { kind: `${trapKind} · ${trapState}`, name: trap },
};
const wide = [rows.decision, rows.trap, rows.convention];
const narrow = [rows.trap, rows.convention, rows.decision];
const wy = (i: number) => 90 + i * 100;
const ny = (i: number) => 334 + i * 92;
---

<Figure {number} {caption} {grid} {motion}>
  <Canvas layout="wide" {id} {title} {desc} viewBox="0 0 760 400">
    <BrokenRing cx={560} cy={195} r={130} width={5} />
    <text class="dg-text dg-text--strong" x={560} y={40} text-anchor="middle">{map}</text>
    <Link x1={262} y1={wy(0)} x2={540} y2={145} arrow="end" inset={16} insetEnd={22} label={appliesTo} labelAt={0.33} />
    <Link x1={262} y1={wy(1)} x2={540} y2={145} arrow="end" inset={16} insetEnd={22} />
    <Link x1={262} y1={wy(1)} x2={540} y2={250} arrow="end" inset={16} insetEnd={22} />
    <Link x1={262} y1={wy(2)} x2={540} y2={250} arrow="end" inset={16} insetEnd={22} label={appliesTo} labelAt={0.33} />
    {wide.map((r, i) => (
      <>
        <text class="dg-text dg-text--muted" x={12} y={wy(i) - 20} dominant-baseline="central">{r.kind}</text>
        {wrap(r.name, 25).map((l, j) => <text class="dg-text" x={12} y={wy(i) + j * 18} dominant-baseline="central">{l}</text>)}
        <Disc cx={262} cy={wy(i)} r={13} tone="record" />
        <Actor kind="agent" cx={262} cy={wy(i) - 26} r={7} />
      </>
    ))}
    <Disc cx={540} cy={145} r={18} tone="record" label={first} labelPosition="right" />
    <Actor kind="agent" cx={562} cy={125} r={7} />
    <Disc cx={540} cy={250} r={18} tone="record" label={second} labelPosition="right" />
    <Actor kind="agent" cx={562} cy={230} r={7} />
    <Actor kind="agent" cx={20} cy={376} r={9} label={agent} />
  </Canvas>
  <Canvas layout="narrow" {id} {title} {desc} viewBox="0 0 340 630">
    <BrokenRing cx={180} cy={150} r={110} width={5} />
    <text class="dg-text dg-text--strong" x={180} y={20} text-anchor="middle">{map}</text>
    <Link x1={14} y1={ny(2)} x2={14} y2={110} width={1.5} />
    <Link x1={14} y1={110} x2={170} y2={110} arrow="end" width={1.5} insetEnd={22} />
    <Link x1={32} y1={ny(1)} x2={32} y2={195} width={1.5} />
    <Link x1={32} y1={195} x2={170} y2={195} arrow="end" width={1.5} insetEnd={22} />
    <text class="dg-text dg-text--muted" x={44} y={284} dominant-baseline="central">{appliesTo}</text>
    <Disc cx={170} cy={110} r={16} tone="record" label={first} labelPosition="right" />
    <Actor kind="agent" cx={190} cy={92} r={7} />
    <Disc cx={170} cy={195} r={16} tone="record" label={second} labelPosition="right" />
    <Actor kind="agent" cx={190} cy={177} r={7} />
    {narrow.map((r, i) => (
      <>
        <Link x1={62} y1={ny(i)} x2={i === 1 ? 32 : 14} y2={ny(i)} width={1.5} />
        <Disc cx={62} cy={ny(i)} r={12} tone="record" />
        <Actor kind="agent" cx={62} cy={ny(i) - 24} r={7} />
        <text class="dg-text dg-text--muted" x={98} y={ny(i) - 20} dominant-baseline="central">{r.kind}</text>
        {wrap(r.name, 25).map((l, j) => <text class="dg-text" x={98} y={ny(i) + j * 18} dominant-baseline="central">{l}</text>)}
      </>
    ))}
    <Actor kind="agent" cx={20} cy={604} r={9} label={agent} />
  </Canvas>
</Figure>
