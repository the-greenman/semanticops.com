---
import { labelAt, type LabelPosition } from "./geometry";
import Knockout from "./Knockout.astro";
import type { Tone } from "./tones";

/**
 * A flat filled disc: a record, a unit of knowledge. Hollow draws only its ring
 * (derived output). A knockout gap is cut around it by default.
 */
interface Props {
  cx: number;
  cy: number;
  r: number;
  /** Which idea the disc carries; sets its colour. */
  tone?: Tone;
  /** Width of the ground-coloured gap cut around the disc. 0 for none. */
  knockout?: number;
  /** Draw only a ring, for derived output. */
  hollow?: boolean;
  /** Short label. Pass an empty string for none. */
  label?: string;
  labelPosition?: LabelPosition;
  /** Appear by growing from its centre, after `delay` seconds (motion figures only). */
  pop?: boolean;
  delay?: number;
  /** Extra classes on the group. */
  class?: string;
}

const { cx, cy, r, tone = "record", knockout = 3, hollow = false, label = "", labelPosition = "below", pop = false, delay = 0, class: className } = Astro.props;

const place = labelAt(cx, cy, r, labelPosition);
---

<g class:list={["dg-node", `dg-tone--${tone}`, pop && "dg-pop", className]} style={pop ? `transform-origin:${cx}px ${cy}px;--dg-delay:${delay}s` : undefined}>
  {knockout > 0 && <Knockout {cx} {cy} r={r + knockout} />}
  <circle class:list={["dg-disc", hollow && "dg-disc--hollow", tone === "note" && "dg-disc--note"]} {cx} {cy} {r}></circle>
  {
    label && (
      <text
        class:list={["dg-text", labelPosition === "inside" && "dg-text--on-disc"]}
        x={place.x}
        y={place.y}
        text-anchor={place.anchor}
        dominant-baseline={place.base}
      >
        {label}
      </text>
    )
  }
</g>
