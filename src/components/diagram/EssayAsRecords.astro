---
import Actor from "./Actor.astro";
import BrokenRing from "./BrokenRing.astro";
import Canvas from "./Canvas.astro";
import Disc from "./Disc.astro";
import Figure from "./Figure.astro";
import Link from "./Link.astro";
import Page from "./Page.astro";
import RingNode from "./RingNode.astro";
import { wrap } from "./geometry";

/**
 * A real essay, stored as records. The essay is a container: an essay record, then one record
 * per paragraph, in order, written by a person. A quotation and two sources are records of their
 * own that point at a paragraph, and so is an agent's comment. The published page takes only the
 * paragraphs.
 */
interface Props {
  number?: number;
  caption?: string;
  id?: string;
  /** The container's title: the essay's name. */
  essay?: string;
  identity?: string;
  paragraphs?: string;
  /** What supports the first paragraph, and what stands against it. */
  quotation?: string;
  source?: string;
  counterSource?: string;
  evidences?: string;
  counters?: string;
  comment?: string;
  commentsOn?: string;
  published?: string;
  site?: string;
  human?: string;
  agent?: string;
  grid?: boolean;
  motion?: boolean;
}

const {
  number = 6,
  caption = "The essay is a container of paragraph records, in order. Evidence and comments are records of their own that point at a paragraph. The published page takes only the paragraphs.",
  id = "dg-essay-as-records",
  essay = "Rebuilding Small Democracy",
  identity = "essay",
  paragraphs = "paragraphs",
  quotation = "Pateman",
  source = "Stealth Democracy",
  counterSource = "Carter 2006",
  evidences = "evidences",
  counters = "counters",
  comment = "comment",
  commentsOn = "comments-on",
  published = "published",
  site = "mudemocracy.org",
  human = "person",
  agent = "agent",
  grid = true,
  motion = false,
} = Astro.props;

const title = "An essay stored as records";
const desc = `A broken ring, the container ${essay}, holds an ${identity} record and three numbered paragraph records in order, each marked with a circle for a ${human}. Outside it, a quotation (${quotation}) and a source (${source}) point at paragraph 1 with ${evidences}, and a second source (${counterSource}) points at it with ${counters}. A ${comment} record, marked with a notched square for an ${agent}, points at paragraph 2 with ${commentsOn}. An arrow, ${published}, leads from the container to a page at ${site}.`;
const rows = [
  { kind: "comment", name: comment, relation: commentsOn },
  { kind: "quotation", name: quotation, relation: evidences },
  { kind: "source", name: source, relation: evidences },
  { kind: "source", name: counterSource, relation: counters },
];
const ry = (i: number) => 356 + i * 66;
---

<Figure {number} {caption} {grid} {motion}>
  <Canvas layout="wide" {id} {title} {desc} viewBox="0 0 760 400">
    <BrokenRing cx={380} cy={200} r={140} width={5} />
    <text class="dg-text dg-text--strong" x={380} y={36} text-anchor="middle">{essay}</text>
    <Link x1={90} y1={80} x2={380} y2={160} arrow="end" inset={14} insetEnd={18} label={evidences} labelAt={0.33} />
    <Link x1={90} y1={180} x2={380} y2={160} arrow="end" inset={19} insetEnd={18} label={evidences} labelAt={0.33} />
    <Link x1={90} y1={290} x2={380} y2={160} arrow="end" inset={19} insetEnd={18} label={counters} labelAt={0.33} />
    <Link x1={640} y1={310} x2={380} y2={210} arrow="end" inset={14} insetEnd={18} label={commentsOn} labelAt={0.22} />
    <Disc cx={90} cy={80} r={11} tone="record" label={quotation} />
    <RingNode cx={90} cy={180} r={16} tone="ink" inner="dot" label={source} />
    <RingNode cx={90} cy={290} r={16} tone="ink" inner="dot" label={counterSource} />
    <Disc cx={380} cy={105} r={13} tone="record" label={identity} labelPosition="right" />
    {[1, 2, 3].map((n, i) => (
      <>
        <Disc cx={380} cy={160 + i * 50} r={14} tone="record" label={String(n)} labelPosition="inside" />
        <Actor kind="human" cx={404} cy={146 + i * 50} r={6} />
      </>
    ))}
    <text class="dg-text" x={380} y={296} text-anchor="middle">{paragraphs}</text>
    <Disc cx={640} cy={310} r={11} tone="record" label={comment} />
    <Actor kind="agent" cx={662} cy={296} r={7} />
    <Link x1={524} y1={140} x2={604} y2={120} tone="ink" arrow="end" />
    <text class="dg-text dg-text--muted" x={564} y={108} text-anchor="middle">{published}</text>
    <Page x={610} y={40} w={120} h={150} lines={7} />
    <text class="dg-text dg-text--muted" x={670} y={214} text-anchor="middle">{site}</text>
    <Actor kind="human" cx={20} cy={376} r={9} label={human} />
    <Actor kind="agent" cx={140} cy={376} r={9} label={agent} />
  </Canvas>
  <Canvas layout="narrow" {id} {title} {desc} viewBox="0 0 340 660">
    <BrokenRing cx={170} cy={170} r={126} width={5} />
    <text class="dg-text dg-text--strong" x={170} y={22} text-anchor="middle">{essay}</text>
    <Link x1={28} y1={ry(0)} x2={28} y2={185} width={1.5} />
    <Link x1={28} y1={185} x2={170} y2={185} arrow="end" width={1.5} insetEnd={18} />
    <Link x1={12} y1={ry(3)} x2={12} y2={140} width={1.5} />
    <Link x1={12} y1={140} x2={170} y2={140} arrow="end" width={1.5} insetEnd={18} />
    <Disc cx={170} cy={92} r={12} tone="record" label={identity} labelPosition="right" />
    {[1, 2, 3].map((n, i) => (
      <>
        <Disc cx={170} cy={140 + i * 45} r={14} tone="record" label={String(n)} labelPosition="inside" />
        <Actor kind="human" cx={194} cy={126 + i * 45} r={6} />
      </>
    ))}
    <text class="dg-text" x={170} y={266} text-anchor="middle">{paragraphs}</text>
    {rows.map((r, i) => (
      <>
        <Link x1={60} y1={ry(i)} x2={i === 0 ? 28 : 12} y2={ry(i)} width={1.5} />
        {r.kind === "source" ? <RingNode cx={60} cy={ry(i)} r={14} tone="ink" inner="dot" /> : <Disc cx={60} cy={ry(i)} r={11} tone="record" />}
        {r.kind === "comment" && <Actor kind="agent" cx={82} cy={ry(i) - 14} r={7} />}
        {wrap(r.name, 10).map((l, j) => <text class="dg-text" x={98} y={ry(i) - 6 + j * 18 - (wrap(r.name, 10).length - 1) * 9} dominant-baseline="central">{l}</text>)}
        <text class="dg-text dg-text--muted" x={98} y={ry(i) + 14 + (wrap(r.name, 10).length - 1) * 9} dominant-baseline="central">{r.relation}</text>
      </>
    ))}
    <Link x1={264} y1={284} x2={264} y2={392} tone="ink" arrow="end" />
    <text class="dg-text dg-text--muted" x={252} y={330} text-anchor="end" dominant-baseline="central">{published}</text>
    <Page x={209} y={400} w={110} h={130} lines={6} />
    <text class="dg-text dg-text--muted" x={264} y={554} text-anchor="middle">{site}</text>
    <Actor kind="human" cx={20} cy={632} r={9} label={human} />
    <Actor kind="agent" cx={140} cy={632} r={9} label={agent} />
  </Canvas>
</Figure>
