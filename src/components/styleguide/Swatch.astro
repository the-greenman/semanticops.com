---
/**
 * A colour swatch. Give it either a literal value (a primitive, read from tokens.css at
 * build time) or a token name to read live, so it follows the theme. Used only by /styleguide.
 */
interface Props {
  name: string;
  /** A literal colour, for primitives. */
  value?: string;
  /** A semantic token to read live, e.g. "--color-record". */
  token?: string;
  note?: string;
}

const { name, value, token, note } = Astro.props;
const fill = token ? `var(${token})` : (value ?? "transparent");
---

<figure class="swatch">
  <div class="swatch__chip" style={`--swatch:${fill}`}></div>
  <figcaption class="swatch__cap">
    <span class="swatch__name">{name}</span>
    {value && <span class="swatch__value">{value}</span>}
    {note && <span class="swatch__note">{note}</span>}
  </figcaption>
</figure>

<style>
  @layer components {
    .swatch {
      margin: 0;
      min-width: 0;
    }

    .swatch__chip {
      height: 3.5rem;
      border: 1px solid var(--color-line);
      background: var(--swatch);
    }

    .swatch__cap {
      display: grid;
      gap: 2px;
      padding-top: var(--space-xs);
      font-family: var(--font-mono);
      font-size: var(--size-xs);
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-wide);
      overflow-wrap: anywhere;
    }

    .swatch__value,
    .swatch__note {
      color: var(--color-muted);
    }
  }
</style>
