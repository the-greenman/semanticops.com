# Response headers for Cloudflare Workers static assets (other static hosts read this format too).
# Headers from every matching rule are combined, and a header set by two rules gets both values
# joined, so each header is set by one rule only.

# The site is public, read-only data: browser-based agents fetch /llms.txt, /agents/*, the .md
# pages and the sample (/try/*, opened by app.semanticops.com/?open=...) from any origin.
/*
  Access-Control-Allow-Origin: *

# Workers send text types without a charset, and the agent markdown and llms.txt carry non-ASCII.
/*.md
  Content-Type: text/markdown; charset=utf-8

/*.txt
  Content-Type: text/plain; charset=utf-8

# .srs is the SRS ZIP archive (ext:repository). It has no registered media type, and the
# extension is unknown to the host, so name the container format.
/*.srs
  Content-Type: application/zip
