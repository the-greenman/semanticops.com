{
  // Assets-only Worker: no main, no worker code. dist/ is served as plain static files.
  // Deployed by Cloudflare Workers Builds on push; never run `wrangler deploy` by hand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semanticops-com",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "routes": [{ "pattern": "semanticops.com", "custom_domain": true }],
  // Branch builds run `wrangler preview`, which refuses to run without this block (empty is enough).
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
